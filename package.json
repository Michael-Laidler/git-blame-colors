{
  "name": "git-blame-color",
  "displayName": "Git Blame Color",
  "description": "Colorize code lines based on git blame author",
  "version": "0.0.1",
  "publisher": "git-blame-color",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Git Blame Color",
      "properties": {
        "gitBlameColor.mode": {
          "type": "string",
          "default": "author",
          "enum": ["author", "heat", "off"],
          "enumDescriptions": [
            "Color per author",
            "Heat gradient by commit age",
            "Disable all coloring"
          ],
          "description": "Coloring mode"
        },
        "gitBlameColor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable git blame color annotation"
        },
        "gitBlameColor.colors": {
          "type": "object",
          "default": {},
          "description": "Custom colors for authors (author name -> hex color)"
        },
        "gitBlameColor.heatColors": {
          "type": "object",
          "default": {
            "old": "#2196F3",
            "new": "#F44336"
          },
          "properties": {
            "old": {
              "type": "string",
              "default": "#2196F3",
              "description": "Color for the oldest commit"
            },
            "new": {
              "type": "string",
              "default": "#F44336",
              "description": "Color for the newest commit"
            }
          },
          "description": "Heat colors for age-based gradient"
        },
        "gitBlameColor.opacity": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of the blame color overlay (0-1)"
        }
      }
    },
    "commands": [
      {
        "command": "gitBlameColor.toggle",
        "title": "Toggle Git Blame Color"
      },
      {
        "command": "gitBlameColor.show",
        "title": "Show Git Blame Colors"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitBlameColor",
          "title": "Git Blame Color Settings",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitBlameColor": [
        {
          "type": "webview",
          "id": "gitBlameColor.settings",
          "name": "Author Colors"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.21.1",
    "typescript": "^5.3.3"
  }
}
